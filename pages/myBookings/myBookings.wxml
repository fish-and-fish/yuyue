<!-- pages/myBookings/myBookings.wxml -->
<view class="container">
  <view class="tabs">
    <view class="tab {{status === 'BOOKING' ? 'active' : ''}}" data-status="BOOKING" bindtap="switchStatus">已约课程</view>
    <view class="tab {{status === 'COMPLETE' ? 'active' : ''}}" data-status="COMPLETE" bindtap="switchStatus">完成课程</view>
    <view class="tab {{status === 'CANCELLED' ? 'active' : ''}}" data-status="CANCELLED" bindtap="switchStatus">取消课程</view>
  </view>
  <block wx:for="{{bookings}}" wx:key="id">
    <view class="booking_date">{{ item.bookingDate }}</view>
    <view class="booking">
      <view class="booking_left" wx:if="{{status !== 'CANCELLED'}}">
        <view class="course-name">{{item.course.courseName}}({{ item.teacher.teacherName }})</view>
        <view class="time">{{item.bookingStart}} - {{item.bookingEnd}}</view>
      </view>
      <!-- <text class="teacher">{{item.teacher.teacherName}}</text> -->
      <view class="booking_left" wx:if="{{status === 'CANCELLED'}}">
        <view class="course-name">{{item.course.courseName}}({{ item.teacher.teacherName }})  {{item.bookingStart}} - {{item.bookingEnd}}</view>
        <view class="time">取消时间: {{item.cancelTime}}</view>
      </view>

      <view class="actions">
        <button wx:if="{{status === 'BOOKING'}}" bindtap="cancelBooking" data-id="{{item.id}}" class="booking_cancel">取消预约</button>
        <!-- <text wx:if="{{status === 'COMPLETE'}}" class="time_info">完成时间: {{item.completeTime}}</text> -->
        <!-- <text wx:if="{{status === 'CANCELLED'}}" class="time_info">取消时间: {{item.cancelTime}}</text> -->
      </view>
    </view>
  </block>
</view>
<!-- pages/index/index.wxml -->
<view class="nav-bar">
  <view bindtap="handleNavClick" data-url="/pages/index/index">预约课程</view>
  <view bindtap="handleNavClick" data-url="/pages/myBookings/myBookings?status=BOOKING">我的课程</view>
  <view bindtap="handleNavClick" data-url="/pages/profile/profile">个人中心</view>
</view>

