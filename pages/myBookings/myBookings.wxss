/* pages/myBookings/myBookings.wxss */
.container {
  padding: 30rpx 50rpx;
}

.tabs {
  display: flex;
  justify-content: space-around;
  /* margin-bottom: 20px; */
  margin-bottom: 50rpx;
  font-size: 40rpx;
}

.tab {
  padding: 10px;
  border-bottom: 2px solid transparent;
  color: #BBBABA;
}

.tab.active {
  border-bottom: 2px solid #007aff;
  color: #000;
}

.booking_date {
  margin-bottom: 24rpx;
}

.booking_left {
  display: flex;
  flex-direction: column;
  justify-content: center;
  font-size: 28rpx;
}

.booking {
  /* padding: 20px; */
  /* border: 1px solid #ccc; */
  /* margin-bottom: 20px; */
  background: rgb(242, 242, 242);
  margin-bottom: 50rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-radius: 14rpx;
  padding: 30rpx;
}

.booking_cancel {
  padding: 0 36rpx;
  font-size: 28rpx;
  height: 60rpx;
  line-height: 60rpx;
  background: #25AFAF;
  border: none;
  color: #fff;
  border-radius: 36rpx;
}

.course-name {
  /* font-size: 18px; */
  /* margin-bottom: 10px; */
  margin-bottom: 12rpx;
}

.time_info {

}

.time,
.teacher,
.actions {
  /* margin-bottom: 10px; */
}

.name_row {
  /*  */
}

.actions {
  display: flex;
  justify-content: space-between;
}


.nav-bar {
  display: flex;
  justify-content: space-around;
  position: fixed;
  bottom: 0;
  width: 100%;
  background-color: #fff;
  border-top: 1px solid #ddd;
  height: 60px;
  /* 增加高度 */
  padding: 10px 0;
  /* 调整内边距 */
}
