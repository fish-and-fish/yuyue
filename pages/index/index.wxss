.container {
  /* padding: 20px; */
}
.list_content {
  /* padding 调整 */
  padding: 90rpx 80rpx 50rpx 80rpx; 
}
.list_title {
  color: #000000;
  margin-bottom: 70rpx;
  /*  字体大小 调整 */
  font-size: 40rpx;
}
.course {
  display: flex;
  align-items: center;
  /* 底边距 调整 */
  margin-bottom: 70rpx;
  /* 课程名 字体大小 调整 */
  font-size: 40rpx;
  /* font-weight: 300; */
}
.course-image {
  /* 课程图片 大小 右边距 调整 */
  width: 150rpx;
  height: 150rpx;
  margin-right: 110rpx;
}
.nav-bar {
display: flex;
justify-content: space-around;
position: fixed;
bottom: 0;
width: 100%;
background-color: #fff;
border-top: 1px solid #ddd;
height: 60px; /* 增加高度 */
padding: 10px 0; /* 调整内边距 */
}
