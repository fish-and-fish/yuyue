/* pages/courseBooking/courseBooking.wxss */
.container {
  /* padding: 20px; */
  /* padding 调整 */
  padding: 60rpx 60rpx 50rpx 60rpx;
}

.course_info {
  /* 预定课程信息 字体大小 边距 调整 */
  display: flex;
  align-items: center;
  margin-bottom: 50rpx;
  font-size: 40rpx;
  font-size: 300;
}

.course-image {
    /* 课程图片 大小 右边距 调整 */
    width: 150rpx;
    height: 150rpx;
    margin-right: 110rpx;
}

.course-name {
  /* font-size: 24px; */
  /* margin-bottom: 20px; */
}

.container_label {
  margin-bottom: 30rpx;
  font-size: 40rpx;
  margin-top: 36rpx;
}

.picker {
  /* margin-bottom: 20px; */
  /* padding: 10px; */
  width: 100%;
  height: 86rpx;
  display: flex;
  align-items: center;
  /* 选择器的背景色 */
  background: rgb(242, 242, 242);
  box-sizing: border-box;
  padding: 0 28rpx;
  color: #727272;
  font-size: 28rpx;
  border-radius: 10rpx;
}

.time-slots {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.time-slot {
  /* width: 30%; */
  /* padding: 10px; */
  /* margin: 5px; */
  /* border: 1px solid #ccc; */
  /* text-align: center; */
  width: 30%;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1px #D8D8D8 solid;
  font-size: 28rpx;
  margin-bottom: 30rpx;
  border-radius: 10rpx;
  font-weight: lighter;
}

.time-slot.selected {
  background-color: #007aff;
  color: white;
}

.confirm_btn {
  margin-top: 30rpx;
  background: #2C2C2C;
  color: #F5F5F5;
}